# No real exchange credentials exist yet — this app currently runs entirely
# on mock adapters (app/exchange_adapters/mock.py). This file documents the
# shape a real .env would need once Stage 2/3 (real adapters) land; none of
# these are read by the app today.

# PORTFOLIO_DB_PATH=portfolio.db

# Swyftx: real adapter exists now (app/exchange_adapters/swyftx.py) but is
# unverified end-to-end (see docs/SWYFTX_API_AUDIT.md). SWYFTX_ATTESTED_READONLY
# must be the literal string "true", and only after you've confirmed in the
# Swyftx UI that this key has no order-placement or withdrawal scope — the app
# refuses to sync without it (fail-closed; see docs/SECURITY.md §2).
# SWYFTX_API_KEY=
# SWYFTX_ATTESTED_READONLY=true

# COINBASE_API_KEY=
# COINBASE_API_SECRET=
# KUCOIN_API_KEY=
# KUCOIN_API_SECRET=
# KUCOIN_API_PASSPHRASE=
# GATE_API_KEY=
# GATE_API_SECRET=
# CRYPTOCOM_API_KEY=
# CRYPTOCOM_API_SECRET=
